# Ignore build artifacts
**/Builds/**/
**/*.o
**/*.a
**/*.so
**/*.d
**/*.vst3/

# Test runner build outputs (kept out of plugin build tree)
/tests/build/
/tests/runtests
/tests/measure_sat

# CMake build directories (CI uses /build/; local dev sometimes uses /build-cmake/)
/build/
/build-cmake/

# Claude Code local files and parallel-agent worktrees (the latter are GBs)
/.claude/

# Ignore ST folder
**/.stfolder/

# Ignore local notes and files
NEXT_STEPS.local.md
DONE_STEPS.local.md
PERFORMANCE_OPTIMIZATION.local.md
UI_PLAN.local.md
saturation-v12-spec.md
PULTEC_DEV.md
/eq-research/**
PRD.md
SKILLS.md
CLAUDE.md
/JuceLibraryCode/**

# Keep source
!Source/
!Source/**

# Keep Projucer files
*.jucer

# Keep vscode properties
.vscode/
!.vscode/
!.vscode/**

# Runtime theme/settings file (PropertiesFile CWD fallback during VST3 helper scan)
MooDuck.settings
